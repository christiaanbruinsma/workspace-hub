{
  "app-id": "io.github.christiaanbruinsma.WorkspaceHub",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "command": "workspace-hub",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=home:ro",
    "--filesystem=host-os:ro",
    "--filesystem=xdg-data/applications:ro",
    "--filesystem=xdg-data/flatpak/exports/share/applications:ro",
    "--filesystem=xdg-data/flatpak/exports/share/icons:ro",
    "--filesystem=/var/lib/flatpak/exports/share/applications:ro",
    "--filesystem=/var/lib/flatpak/exports/share/icons:ro",
    "--filesystem=/var/lib/flatpak/app:ro",
    "--filesystem=/var/lib/snapd/desktop/applications:ro",
    "--filesystem=/var/lib/snapd/desktop/icons:ro",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "workspace-hub",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
